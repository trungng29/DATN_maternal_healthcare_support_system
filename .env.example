# ==============================================
# Environment Variables Template
# Copy this to .env and adjust values for local run
# ==============================================

# --- General ---
COMPOSE_PROJECT_NAME=mhss
ENVIRONMENT=development

# --- Database (PostgreSQL) ---
# When running via Docker Compose, DB_HOST should be "postgres"
# When running locally (npm run start), DB_HOST should be "localhost"
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mhss_db
DB_USER=admin
DB_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# --- Security & JWT ---
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRATION=3600s
JWT_REFRESH_SECRET=super-secret-refresh-key
JWT_REFRESH_EXPIRATION=7d

# --- Exposed Ports (Host Bindings) ---
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# Các Service Port (dùng để test riêng biệt nếu cần)
AUTH_SERVICE_PORT=3001
PATIENT_SERVICE_PORT=3002
DOCTOR_SERVICE_PORT=3003
MEDICAL_RECORD_SERVICE_PORT=3004
BILLING_SERVICE_PORT=3005
APPOINTMENT_SERVICE_PORT=3006
QUEUE_SERVICE_PORT=3007
CONSULTATION_SERVICE_PORT=3008
NOTIFICATION_SERVICE_PORT=3009
AUDIT_LOG_SERVICE_PORT=3010
