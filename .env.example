# ==============================================
# Environment Variables Template
# Copy this file to .env and adjust local secrets/ports as needed.
# Do NOT commit real secrets or private keys.
# ==============================================

# ──────────────────────────────────────────────
# General
# ──────────────────────────────────────────────
COMPOSE_PROJECT_NAME=maternal-healthcare-support-system
ENVIRONMENT=development

# ──────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080

# ──────────────────────────────────────────────
# Kong API Gateway
# ──────────────────────────────────────────────
GATEWAY_PORT=8080
KONG_ADMIN_PORT=8001
KONG_MANAGER_PORT=8002

# Kong has its own PostgreSQL database for gateway configuration.
# Do not use this database for Authentication Service data.
KONG_PG_DATABASE=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD=kongpass

# ──────────────────────────────────────────────
# Auth Service
# ──────────────────────────────────────────────
# Auth OpenAPI local server: http://localhost:5003
AUTH_SERVICE_PORT=5003

# Internal app port used inside the auth-service container.
# Usually keep this equal to 5003 because Kong routes to auth-service:5003.
AUTH_SERVICE_INTERNAL_PORT=5003

# ──────────────────────────────────────────────
# Auth Database
# ──────────────────────────────────────────────
# Auth Service owns this PostgreSQL database.
# This is separate from Kong PostgreSQL.
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=authpass

# Host port for local development/migrations.
# Container port is always 5432.
AUTH_DB_PORT=5433

# Use this connection string when running Prisma commands from the host machine:
#   cd services
#   set AUTH_DATABASE_URL=postgresql://auth:authpass@localhost:5433/auth?schema=public      # CMD
#   $env:AUTH_DATABASE_URL="postgresql://auth:authpass@localhost:5433/auth?schema=public"  # PowerShell
AUTH_DATABASE_URL=postgresql://auth:authpass@localhost:5433/auth?schema=public

# Docker Compose constructs the container connection string separately as:
# postgresql://${AUTH_DB_USER}:${AUTH_DB_PASSWORD}@auth-database:5432/${AUTH_DB_NAME}?schema=public
# because localhost inside a container is not the host machine.

# ──────────────────────────────────────────────
# JWT Access Token — Auth Service
# ──────────────────────────────────────────────
# Access tokens are signed by Auth Service using RS256.
# Private key must be provided via environment variable or a secret manager.
# Never commit real private keys.

AUTH_JWT_ISSUER=maternal-healthcare-auth
AUTH_JWT_AUDIENCE=maternal-healthcare-api
AUTH_JWT_KEY_ID=local-dev-key
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh tokens are opaque random values. Auth Service stores only HMAC-SHA256 hashes.
# Use a strong random value for pepper. Do not commit real production secrets.
AUTH_REFRESH_TOKEN_PEPPER=replace-with-local-dev-refresh-token-pepper
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Password reset tokens are opaque and only their HMAC-SHA256 hashes are stored.
AUTH_PASSWORD_RESET_PEPPER=replace-with-local-dev-password-reset-pepper
AUTH_PASSWORD_RESET_TTL_MINUTES=15
AUTH_PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# SMTP configuration for password-reset email.
# Docker: use a provider hostname/service reachable from the Auth container, not localhost.
# AUTH_SMTP_USER/PASSWORD may both be empty only for an anonymous SMTP relay.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_EMAIL_FROM=

# Put an escaped PEM private key here for local development only.
# Example PowerShell to convert a PEM file to escaped newline format:
#   $privateKey = (Get-Content .\auth-private.pem -Raw).Replace("`r`n", "\n").Replace("`n", "\n")
#   $privateKey
# Then paste the output below.
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_LOCAL_DEV_PRIVATE_KEY\n-----END PRIVATE KEY-----"

# Public key is not used by Auth Service signing code yet.
# It will be useful for JWKS/Kong JWT validation in a later phase.
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_LOCAL_DEV_PUBLIC_KEY\n-----END PUBLIC KEY-----"

# ──────────────────────────────────────────────
# Sample Service
# ──────────────────────────────────────────────
SAMPLE_SERVICE_PORT=5001
SAMPLE_SERVICE_INTERNAL_PORT=5000

# ──────────────────────────────────────────────
# Future infrastructure placeholders
# Keep disabled until a phase explicitly needs them.
# ──────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://localhost:5672

# ──────────────────────────────────────────────
# Doctor Service
# ──────────────────────────────────────────────
DOCTOR_SERVICE_PORT=5005
DOCTOR_SERVICE_INTERNAL_PORT=5005
DOCTOR_DB_NAME=doctor
DOCTOR_DB_USER=doctor
DOCTOR_DB_PASSWORD=doctorpass
DOCTOR_DB_PORT=5435
DOCTOR_DATABASE_URL=postgresql://doctor:doctorpass@localhost:5435/doctor?schema=public
DOCTOR_TIMEZONE=Asia/Bangkok
DOCTOR_MAX_AVAILABILITY_RANGE_DAYS=31
# Optional until Auth internal account lookup contract is approved.
AUTH_ACCOUNT_LOOKUP_URL=http://localhost:5003/internal/accounts
INTERNAL_SERVICE_AUTH_SECRET=local-dev-internal-secret
LOG_LEVEL=info

# Receptionist Service
RECEPTIONIST_SERVICE_PORT=5006
RECEPTIONIST_SERVICE_INTERNAL_PORT=5006
RECEPTIONIST_DB_NAME=receptionist
RECEPTIONIST_DB_USER=receptionist
RECEPTIONIST_DB_PASSWORD=receptionistpass
RECEPTIONIST_DB_PORT=5436
RECEPTIONIST_DATABASE_URL=postgresql://receptionist:receptionistpass@localhost:5436/receptionist?schema=public
RECEPTION_IDEMPOTENCY_TTL_HOURS=24
# Receptionist Service
RECEPTIONIST_SERVICE_PORT=5006
RECEPTIONIST_SERVICE_INTERNAL_PORT=5006
RECEPTIONIST_DB_NAME=receptionist
RECEPTIONIST_DB_USER=receptionist
RECEPTIONIST_DB_PASSWORD=receptionistpass
RECEPTIONIST_DB_PORT=5436
RECEPTIONIST_DATABASE_URL=postgresql://receptionist:receptionistpass@localhost:5436/receptionist?schema=public
RECEPTION_IDEMPOTENCY_TTL_HOURS=24

# Patient Service (internal-only in Docker Compose)
PATIENT_DB_NAME=patient
PATIENT_DB_USER=patient
PATIENT_DB_PASSWORD=patientpass
# Host-only URL if a developer explicitly publishes Patient DB port in an override.
PATIENT_DATABASE_URL=postgresql://patient:patientpass@localhost:5434/patient?schema=public
# Generate secrets locally; never commit production values.
PATIENT_NATIONAL_ID_ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-hex-key
PATIENT_NATIONAL_ID_LOOKUP_PEPPER=replace-with-strong-lookup-pepper

# User-key rotation: current static key plus optional Auth JWKS refresh fallback.
AUTH_JWKS_URL=http://auth-service:5003/.well-known/jwks.json
AUTH_JWKS_CACHE_TTL_SECONDS=300

# Dedicated service-to-service RS256 trust domain. Do not reuse end-user JWTs.
PATIENT_INTERNAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_INTERNAL_PUBLIC_KEY\n-----END PUBLIC KEY-----"
PATIENT_INTERNAL_JWT_KEY_ID=internal-dev-key
PATIENT_INTERNAL_JWT_ISSUER=maternal-healthcare-internal
PATIENT_INTERNAL_JWT_AUDIENCE=patient-service
