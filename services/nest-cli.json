{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/auth-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/auth-service/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/auth-service",
  "projects": {
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "doctor-service": {
      "type": "application",
      "root": "apps/doctor-service",
      "entryFile": "main",
      "sourceRoot": "apps/doctor-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/doctor-service/tsconfig.app.json"
      }
    },
    "patient-service": {
      "type": "application",
      "root": "apps/patient-service",
      "entryFile": "main",
      "sourceRoot": "apps/patient-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/patient-service/tsconfig.app.json"
      }
    },
    "receptionist-service": {
      "type": "application",
      "root": "apps/receptionist-service",
      "entryFile": "main",
      "sourceRoot": "apps/receptionist-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/receptionist-service/tsconfig.app.json"
      }
    },
    "sample-service": {
      "type": "application",
      "root": "apps/sample-service",
      "entryFile": "main",
      "sourceRoot": "apps/sample-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/sample-service/tsconfig.app.json"
      }
    },
    "service-catalog-service": {
      "type": "application",
      "root": "apps/service-catalog-service",
      "entryFile": "main",
      "sourceRoot": "apps/service-catalog-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/service-catalog-service/tsconfig.app.json"
      }
    }
  }
}
