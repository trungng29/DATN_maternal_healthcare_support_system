{
  "name": "services",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/auth-service/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate && prisma generate --schema=prisma/receptionist/schema.prisma",
    "prisma:generate:receptionist": "prisma generate --schema=prisma/receptionist/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:receptionist:dev": "prisma migrate dev --schema=prisma/receptionist/schema.prisma",
    "prisma:migrate:receptionist:deploy": "prisma migrate deploy --schema=prisma/receptionist/schema.prisma",
    "prisma:seed": "prisma db seed",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/auth-service/test/jest-e2e.json",
    "test:e2e:receptionist": "jest --config ./apps/receptionist-service/test/jest-e2e.json",
    "start:receptionist": "nest start receptionist-service",
    "start:receptionist:dev": "nest start receptionist-service --watch",
    "prisma:migrate:receptionist": "prisma migrate deploy --schema prisma/receptionist/schema.prisma",
    "start:doctor": "nest start doctor-service",
    "start:doctor:dev": "nest start doctor-service --watch",
    "prisma:generate:doctor": "prisma generate --schema prisma/doctor/schema.prisma",
    "prisma:migrate:doctor": "prisma migrate deploy --schema prisma/doctor/schema.prisma",
    "prisma:seed:doctor": "ts-node prisma/doctor/seed.ts",
    "prisma:generate:patient": "prisma generate --schema prisma/patient/schema.prisma",
    "prisma:migrate:patient": "prisma migrate deploy --schema prisma/patient/schema.prisma",
    "test:patient": "jest --runInBand --testPathPatterns=apps/patient-service/src",
    "test:patient:api": "jest --runInBand --testPathPatterns=apps/patient-service/test/api",
    "test:patient:integration": "node scripts/run-patient-integration.cjs",
    "test:patient:e2e": "node scripts/run-patient-e2e.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.16.2",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.0.0",
    "embedded-postgres": "^16.14.0-beta.17",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.16.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}
