generator client {
  provider = "prisma-client-js"
  output   = "../../generated/appointment-client"
}

datasource db {
  provider = "postgresql"
  url      = env("APPOINTMENT_DATABASE_URL")
}

enum BookingChannel {
  ONLINE
  RECEPTION
  WALK_IN
}

enum SelectionMode {
  DOCTOR
  RANK
}

enum AppointmentStatus {
  BOOKED
  REASSIGNMENT_REQUIRED
  CHECKED_IN
  IN_CLINICAL_CARE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SlotHoldStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  RELEASED
}

model Appointment {
  id                       String                         @id @default(uuid()) @db.Uuid
  appointmentCode          String                         @unique @map("appointment_code") @db.VarChar(24)
  patientId                String                         @map("patient_id") @db.Uuid
  serviceId                String                         @map("service_id") @db.Uuid
  channel                  BookingChannel
  selectionMode            SelectionMode                  @map("selection_mode")
  requestedDoctorId        String?                        @map("requested_doctor_id") @db.Uuid
  requestedRankCode        String?                        @map("requested_rank_code") @db.VarChar(50)
  assignedDoctorId         String                         @map("assigned_doctor_id") @db.Uuid
  assignedRankCode         String                         @map("assigned_rank_code") @db.VarChar(50)
  specialtyId              String                         @map("specialty_id") @db.Uuid
  startAt                  DateTime                       @map("start_at") @db.Timestamptz(6)
  endAt                    DateTime                       @map("end_at") @db.Timestamptz(6)
  status                   AppointmentStatus              @default(BOOKED)
  serviceNameSnapshot      String                         @map("service_name_snapshot") @db.VarChar(200)
  serviceVersion           Int                            @map("service_version")
  basePriceId              String                         @map("base_price_id") @db.Uuid
  baseAmountMinor          BigInt                         @map("base_amount_minor")
  rankSurchargePriceId     String?                        @map("rank_surcharge_price_id") @db.Uuid
  rankSurchargeAmountMinor BigInt                         @map("rank_surcharge_amount_minor")
  estimatedTotalMinor      BigInt                         @map("estimated_total_minor")
  currency                 String                         @default("VND") @db.Char(3)
  queueEstimateMinutes     Int?                           @map("queue_estimate_minutes")
  availabilityVersion      BigInt                         @map("availability_version")
  receptionCaseId          String?                        @map("reception_case_id") @db.Uuid
  encounterId              String?                        @map("encounter_id") @db.Uuid
  checkedInAt              DateTime?                      @map("checked_in_at") @db.Timestamptz(6)
  clinicalStartedAt        DateTime?                      @map("clinical_started_at") @db.Timestamptz(6)
  completedAt              DateTime?                      @map("completed_at") @db.Timestamptz(6)
  cancellationReason       String?                        @map("cancellation_reason") @db.VarChar(500)
  rescheduleCount          Int                            @default(0) @map("reschedule_count")
  version                  Int                            @default(1)
  createdAt                DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  holds                    SlotHold[]
  histories                AppointmentAssignmentHistory[]

  @@index([patientId, startAt])
  @@index([assignedDoctorId, startAt, endAt])
  @@index([status, startAt])
  @@map("appointments")
}

model SlotHold {
  id                      String         @id @default(uuid()) @db.Uuid
  patientId               String         @map("patient_id") @db.Uuid
  serviceId               String         @map("service_id") @db.Uuid
  doctorId                String         @map("doctor_id") @db.Uuid
  rankCode                String         @map("rank_code") @db.VarChar(50)
  selectionMode           SelectionMode  @map("selection_mode")
  startAt                 DateTime       @map("start_at") @db.Timestamptz(6)
  endAt                   DateTime       @map("end_at") @db.Timestamptz(6)
  status                  SlotHoldStatus @default(ACTIVE)
  expiresAt               DateTime       @map("expires_at") @db.Timestamptz(6)
  consumedByAppointmentId String?        @map("consumed_by_appointment_id") @db.Uuid
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  appointment             Appointment?   @relation(fields: [consumedByAppointmentId], references: [id], onDelete: SetNull)

  @@index([doctorId, startAt, endAt, status])
  @@index([status, expiresAt])
  @@map("slot_holds")
}

model AppointmentAssignmentHistory {
  id            String      @id @default(uuid()) @db.Uuid
  appointmentId String      @map("appointment_id") @db.Uuid
  fromDoctorId  String?     @map("from_doctor_id") @db.Uuid
  toDoctorId    String      @map("to_doctor_id") @db.Uuid
  rankCode      String      @map("rank_code") @db.VarChar(50)
  reason        String      @db.VarChar(500)
  actorId       String      @map("actor_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_assignment_history")
}

model AppointmentIdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  scope          String   @db.VarChar(100)
  key            String   @db.VarChar(128)
  requestHash    String   @map("request_hash") @db.Char(64)
  resourceId     String?  @map("resource_id") @db.Uuid
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@map("appointment_idempotency_records")
}

model AppointmentAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type") @db.VarChar(100)
  actorId    String?  @map("actor_id") @db.Uuid
  resourceId String?  @map("resource_id") @db.Uuid
  reason     String?  @db.VarChar(500)
  requestId  String?  @map("request_id") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resourceId, createdAt])
  @@map("appointment_audit_logs")
}

model AppointmentOutboxEvent {
  id               String    @id @default(uuid()) @db.Uuid
  eventType        String    @map("event_type") @db.VarChar(120)
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  payload          Json
  status           String    @default("PENDING") @db.VarChar(20)
  attempts         Int       @default(0)
  occurredAt       DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)

  @@index([status, occurredAt])
  @@map("appointment_outbox_events")
}
